{
  "expo": {
    "name": "Termix",
    "slug": "termix",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "termix-mobile",
    "githubUrl": "https://github.com/Termix-SSH/Mobile",
    "backgroundColor": "#141513",
    "userInterfaceStyle": "automatic",
    "ios": {
      "appleTeamId": "2CPC5YZYFN",
      "supportsTablet": true,
      "bundleIdentifier": "com.karmaa.termix",
      "icon": {
        "dark": "./assets/images/ios-dark.png",
        "light": "./assets/images/icon.png",
        "tinted": "./assets/images/ios-tinted.png"
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Use Face ID to unlock Termix."
      }
    },
    "android": {
      "package": "com.karmaa.termix",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#141513"
      },
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./plugins/withOidcCallbackIntentFilter.js",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock Termix."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141513",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#141513"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "gradle": "8.13.1"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withIOSNetworkSecurity.js",
      "./plugins/withNetworkSecurityConfig.js",
      "./plugins/withAndroidLocalNetworkSsl.js",
      "./plugins/withTermixWidgets.js",
      "./plugins/withPodDeploymentTarget.js",
      "./plugins/withNotificationIcon.js",
      "./plugins/withTermixSsh.js",
      "./plugins/withTermixTerminals.js",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/CaskaydiaCoveNerdFontMono-Regular.ttf",
              "./assets/fonts/CaskaydiaCoveNerdFontMono-Bold.ttf",
              "./assets/fonts/CaskaydiaCoveNerdFontMono-Italic.ttf",
              "./assets/fonts/CaskaydiaCoveNerdFontMono-BoldItalic.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "CaskaydiaCove NFM",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/CaskaydiaCoveNerdFontMono-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/CaskaydiaCoveNerdFontMono-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/CaskaydiaCoveNerdFontMono-Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/CaskaydiaCoveNerdFontMono-BoldItalic.ttf",
                    "weight": 700,
                    "style": "italic"
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-dev-client",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "cf86f530-ca4b-44bf-bb68-4d178b264910",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "TermixWidgetsExtension",
                  "bundleIdentifier": "com.karmaa.termix.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.karmaa.termix.widgets"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "assetBundlePatterns": ["assets/**/*"],
    "owner": "termix"
  }
}
