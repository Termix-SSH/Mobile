<?xml version="1.0" encoding="utf-8"?>
<!-- One launchable host tile. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/termix_item_root"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="7dp"
  android:paddingEnd="7dp"
  android:paddingTop="6dp"
  android:paddingBottom="6dp"
  android:background="@drawable/termix_widget_card">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
      android:id="@+id/termix_item_dot"
      android:layout_width="6dp"
      android:layout_height="6dp"
      android:layout_marginEnd="5dp"
      android:src="@drawable/termix_widget_dot"
      android:importantForAccessibility="no" />

    <TextView
      android:id="@+id/termix_item_name"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="1"
      android:ellipsize="end"
      android:textColor="@color/termix_widget_text_primary"
      android:textSize="11sp"
      android:textStyle="bold"
      android:fontFamily="monospace" />

    <ImageView
      android:id="@+id/termix_item_pin"
      android:layout_width="3dp"
      android:layout_height="3dp"
      android:layout_marginStart="4dp"
      android:src="@drawable/termix_widget_pin"
      android:visibility="gone"
      android:importantForAccessibility="no" />
  </LinearLayout>

  <TextView
    android:id="@+id/termix_item_subtitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:maxLines="1"
    android:ellipsize="middle"
    android:textColor="@color/termix_widget_text_tertiary"
    android:textSize="9sp"
    android:fontFamily="monospace" />
</LinearLayout>
