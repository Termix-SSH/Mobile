<?xml version="1.0" encoding="utf-8"?>
<!--
  Placeholder row shown while a real row is being bound. Without this Android
  falls back to its own loading view, which renders as a bright bar on a dark
  widget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="7dp"
  android:paddingEnd="7dp"
  android:paddingTop="6dp"
  android:paddingBottom="6dp"
  android:background="@drawable/termix_widget_card">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/termix_widget_loading"
    android:textColor="@color/termix_widget_text_tertiary"
    android:textSize="11sp"
    android:fontFamily="monospace"
    android:importantForAccessibility="no" />
</LinearLayout>
