<?xml version="1.0" encoding="utf-8"?>
<!-- Snippets widget: tapping a row runs that command on a host chosen in the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="@dimen/termix_widget_padding"
  android:background="@drawable/termix_widget_background">

  <include layout="@layout/termix_widget_header" />

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <ListView
      android:id="@+id/termix_widget_snippet_list"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:divider="@android:color/transparent"
      android:dividerHeight="@dimen/termix_widget_gap"
      android:scrollbars="none"
      android:listSelector="@android:color/transparent" />

    <include layout="@layout/termix_widget_empty" />
  </FrameLayout>

  <include layout="@layout/termix_widget_footer" />
</LinearLayout>
