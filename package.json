    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "i18next": "^26.5.10",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "lint-staged": "^17.6.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.7.3",
