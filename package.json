    "sonner": "^2.0.8",
    "typescript": "~6.0.3",
    "undici": "^6.21.3"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@termix-ssh/plugin-sdk": {
      "react-dom": "$react-dom"
    }
  }
}
