# Linux build and test image for the libssh2 slice (host tests and JNI for the JVM).
FROM debian:trixie-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential cmake curl ca-certificates libssl-dev pkg-config openjdk-21-jdk-headless python3 docker-cli oathtool \
 && rm -rf /var/lib/apt/lists/*
ARG LIBSSH2=1.11.1
RUN curl -sSL https://libssh2.org/download/libssh2-$LIBSSH2.tar.gz | tar xz -C /opt \
 && cmake -S /opt/libssh2-$LIBSSH2 -B /opt/libssh2-build -DCRYPTO_BACKEND=OpenSSL -DBUILD_SHARED_LIBS=OFF \
      -DBUILD_EXAMPLES=OFF -DBUILD_TESTING=OFF -DENABLE_ZLIB_COMPRESSION=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/libssh2 \
 && cmake --build /opt/libssh2-build -j && cmake --install /opt/libssh2-build
